# Application Configuration
APP_NAME="Meeting Summarizer Enterprise"
APP_VERSION="1.0.0"
DEBUG=True
API_V1_STR="/api/v1"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/meeting_summarizer"
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/meeting_summarizer"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# Security Configuration
SECRET_KEY="your-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# File Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=104857600  # 100MB
ALLOWED_AUDIO_FORMATS=".mp3,.wav,.m4a,.ogg,.flac,.aac"

# AI Service Configuration
OLLAMA_SERVER_URL="http://localhost:11434"
WHISPER_MODEL_DIR="./whisper.cpp/models"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-3.5-turbo"
OPENAI_WHISPER_MODEL="whisper-1"

# Google Gemini Configuration
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-pro"

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-sonnet-20240229"

# Email Configuration
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@meetingsummarizer.com"

# Rate Limiting Configuration
RATE_LIMIT_PER_MINUTE=60

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Celery Configuration
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Speaker Diarization Configuration
HUGGINGFACE_TOKEN=""